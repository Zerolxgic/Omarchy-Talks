[Unit]
Description=VoiceBox backend for Omarchy Talks
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/omarchy-talks/voicebox-src
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/share/omarchy-talks/voicebox-venv/bin/python -m backend.server --host 127.0.0.1 --port 17493 --data-dir %h/.local/share/omarchy-talks/voicebox
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
